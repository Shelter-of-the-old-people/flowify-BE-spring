{
  "_meta": {
    "version": "1.1.0",
    "updated_at": "2026-05-10"
  },
  "services": [
    {
      "key": "discord",
      "label": "Discord",
      "auth_required": false,
      "accepted_input_types": ["TEXT", "SINGLE_ANNOUNCEMENT", "SINGLE_EMAIL", "API_RESPONSE"],
      "config_schema_scope": "per_service",
      "config_schema": {
        "fields": [
          { "key": "webhook_url", "label": "Webhook URL", "type": "secret_text", "required": true },
          { "key": "message_template", "label": "메시지 내용", "type": "textarea", "required": false },
          { "key": "username", "label": "표시 이름", "type": "text", "required": false },
          { "key": "avatar_url", "label": "아바타 URL", "type": "text", "required": false }
        ]
      }
    },
    {
      "key": "gmail",
      "label": "Gmail",
      "auth_required": true,
      "accepted_input_types": ["TEXT", "SINGLE_FILE", "FILE_LIST", "SINGLE_ANNOUNCEMENT", "SINGLE_EMAIL", "API_RESPONSE"],
      "config_schema_scope": "per_service",
      "config_schema": {
        "fields": [
          { "key": "to", "label": "수신자", "type": "email_input", "required": true },
          { "key": "subject", "label": "제목", "type": "text", "required": true },
          { "key": "result_delivery_mode", "label": "결과 전달 방식", "type": "select", "options": ["aggregate", "per_item"], "required": false },
          { "key": "text_result_delivery_mode", "label": "텍스트 결과 전달 방식", "type": "select", "options": ["body", "txt_attachment"], "required": false }
        ]
      }
    },
    {
      "key": "notion",
      "label": "Notion",
      "auth_required": true,
      "accepted_input_types": ["TEXT", "SPREADSHEET_DATA", "API_RESPONSE", "SINGLE_ANNOUNCEMENT", "SINGLE_EMAIL", "ARTICLE_LIST", "EMAIL_LIST", "ANNOUNCEMENT_LIST"],
      "config_schema_scope": "per_service",
      "config_schema": {
        "fields": [
          { "key": "target_type", "label": "대상 위치 유형", "type": "select", "options": ["page", "database"], "required": true },
          { "key": "target_id", "label": "페이지/데이터베이스", "type": "page_picker", "required": true, "picker_supported": true },
          { "key": "item_delivery_mode", "label": "저장 방식", "type": "select", "options": ["aggregate", "per_item"], "required": false },
          { "key": "title_template", "label": "제목 템플릿", "type": "text", "required": false }
        ]
      }
    },
    {
      "key": "google_drive",
      "label": "Google Drive",
      "auth_required": true,
      "accepted_input_types": ["TEXT", "SINGLE_FILE", "FILE_LIST", "SPREADSHEET_DATA"],
      "config_schema_scope": "per_service",
      "config_schema": {
        "fields": [
          { "key": "folder_id", "label": "저장 폴더", "type": "folder_picker", "required": true, "picker_supported": true },
          { "key": "drive_action", "label": "Google Drive 동작", "type": "select", "options": ["copy"], "required": false },
          { "key": "filename_template", "label": "파일명 규칙", "type": "text", "required": false }
        ]
      }
    },
    {
      "key": "google_sheets",
      "label": "Google Sheets",
      "auth_required": true,
      "accepted_input_types": ["TEXT", "SPREADSHEET_DATA", "API_RESPONSE"],
      "config_schema_scope": "per_service",
      "config_schema": {
        "fields": [
          { "key": "spreadsheet_id", "label": "스프레드시트", "type": "sheet_picker", "required": true, "picker_supported": true },
          { "key": "sheet_name", "label": "시트 이름", "type": "text", "required": false },
          { "key": "range_a1", "label": "범위 (A1)", "type": "text", "required": false },
          { "key": "key_column", "label": "기준 컬럼", "type": "text", "required": false },
          { "key": "write_mode", "label": "저장방식", "type": "select", "options": ["append_rows", "overwrite_range", "update_row_by_key", "upsert_row_by_key"], "required": true }
        ]
      }
    }
  ]
}
